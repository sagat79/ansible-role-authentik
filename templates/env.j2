TZ={{ authentik_environment_variables_tz }}

AUTHENTIK_SECRET_KEY={{ authentik_secret_key }}
AUTHENTIK_LOG_LEVEL={{ authentik_loglevel }}

AUTHENTIK_POSTGRESQL__HOST={{ authentik_database_hostname }}
AUTHENTIK_POSTGRESQL__PORT={{ authentik_database_port }}
AUTHENTIK_POSTGRESQL__USER={{ authentik_database_username }}
AUTHENTIK_POSTGRESQL__NAME={{ authentik_database_name }}
AUTHENTIK_POSTGRESQL__PASSWORD={{ authentik_database_password }}
AUTHENTIK_POSTGRESQL__SSLMODE={{ authentik_database_sslmode }}
AUTHENTIK_POSTGRESQL__CONN_MAX_AGE={{ authentik_database_conn_max_age }}
AUTHENTIK_POSTGRESQL__CONN_HEALTH_CHECKS={{ authentik_database_conn_health_checks | to_json }}
AUTHENTIK_POSTGRESQL__DISABLE_SERVER_SIDE_CURSORS={{ authentik_database_disable_server_side_cursors | to_json }}
AUTHENTIK_POSTGRESQL__DEFAULT_SCHEMA={{ authentik_database_default_schema }}

{% if authentik_email_host %}
AUTHENTIK_EMAIL__HOST={{ authentik_email_host }}
AUTHENTIK_EMAIL__PORT={{ authentik_email_port }}
# Optionally authenticate (don't add quotation marks to your password)
AUTHENTIK_EMAIL__USERNAME={{ authentik_email_username }}
AUTHENTIK_EMAIL__PASSWORD={{ authentik_email_password }}
# Use StartTLS
AUTHENTIK_EMAIL__USE_TLS={{ authentik_email_use_tls | to_json }}
# Use SSL
AUTHENTIK_EMAIL__USE_SSL={{ authentik_email_use_ssl | to_json }}
AUTHENTIK_EMAIL__TIMEOUT={{ authentik_email_timeout }}
# Email address authentik will send from, should have a correct @domain
AUTHENTIK_EMAIL__FROM={{ authentik_email_from }}
{% endif %}

{% if authentik_listen_http != '' %}
AUTHENTIK_LISTEN__HTTP={{ authentik_listen_http }}
{% endif %}
{% if authentik_listen_metrics != '' %}
AUTHENTIK_LISTEN__METRICS={{ authentik_listen_metrics }}
{% endif %}
{% if authentik_listen_trusted_proxy_cidrs | length > 0 %}
AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS={{ authentik_listen_trusted_proxy_cidrs | join(',') }}
{% endif %}

{% if authentik_server_web_workers != '' %}
AUTHENTIK_WEB__WORKERS={{ authentik_server_web_workers }}
{% endif %}
{% if authentik_server_web_threads != '' %}
AUTHENTIK_WEB__THREADS={{ authentik_server_web_threads }}
{% endif %}
{% if authentik_path_prefix != '/' %}
AUTHENTIK_WEB__PATH={{ authentik_path_prefix }}/
{% endif %}

{% if authentik_worker_processes != '' %}
AUTHENTIK_WORKER__PROCESSES={{ authentik_worker_processes }}
{% endif %}
{% if authentik_worker_threads != '' %}
AUTHENTIK_WORKER__THREADS={{ authentik_worker_threads }}
{% endif %}

{% if authentik_cookie_domain != '' %}
AUTHENTIK_COOKIE_DOMAIN={{ authentik_cookie_domain }}
{% endif %}
AUTHENTIK_DISABLE_UPDATE_CHECK={{ authentik_disable_update_check | to_json }}

{% if authentik_sessions_unauthenticated_age != '' %}
AUTHENTIK_SESSIONS__UNAUTHENTICATED_AGE={{ authentik_sessions_unauthenticated_age }}
{% endif %}
{% if authentik_cache_timeout != '' %}
AUTHENTIK_CACHE__TIMEOUT={{ authentik_cache_timeout }}
{% endif %}
{% if authentik_reputation_expiry != '' %}
AUTHENTIK_REPUTATION__EXPIRY={{ authentik_reputation_expiry }}
{% endif %}

{% if authentik_bootstrap_email != '' %}
AUTHENTIK_BOOTSTRAP_EMAIL={{ authentik_bootstrap_email }}
{% endif %}
{% if authentik_bootstrap_password != '' %}
AUTHENTIK_BOOTSTRAP_PASSWORD={{ authentik_bootstrap_password }}
{% endif %}
{% if authentik_bootstrap_password_hash != '' %}
AUTHENTIK_BOOTSTRAP_PASSWORD_HASH={{ authentik_bootstrap_password_hash }}
{% endif %}
{% if authentik_bootstrap_token != '' %}
AUTHENTIK_BOOTSTRAP_TOKEN={{ authentik_bootstrap_token }}
{% endif %}

{% if authentik_storage_backend == 's3' %}
AUTHENTIK_STORAGE__BACKEND=s3
{% if authentik_storage_s3_region != '' %}
AUTHENTIK_STORAGE__S3__REGION={{ authentik_storage_s3_region }}
{% endif %}
{% if authentik_storage_s3_endpoint != '' %}
AUTHENTIK_STORAGE__S3__ENDPOINT={{ authentik_storage_s3_endpoint }}
{% endif %}
{% if authentik_storage_s3_access_key != '' %}
AUTHENTIK_STORAGE__S3__ACCESS_KEY={{ authentik_storage_s3_access_key }}
{% endif %}
{% if authentik_storage_s3_secret_key != '' %}
AUTHENTIK_STORAGE__S3__SECRET_KEY={{ authentik_storage_s3_secret_key }}
{% endif %}
AUTHENTIK_STORAGE__S3__BUCKET_NAME={{ authentik_storage_s3_bucket_name }}
{% if authentik_storage_s3_custom_domain != '' %}
AUTHENTIK_STORAGE__S3__CUSTOM_DOMAIN={{ authentik_storage_s3_custom_domain }}
{% endif %}
{% endif %}

{% if authentik_events_context_processors_geoip != '' %}
AUTHENTIK_EVENTS__CONTEXT_PROCESSORS__GEOIP={{ authentik_events_context_processors_geoip }}
{% endif %}
{% if authentik_events_context_processors_asn != '' %}
AUTHENTIK_EVENTS__CONTEXT_PROCESSORS__ASN={{ authentik_events_context_processors_asn }}
{% endif %}

AUTHENTIK_ERROR_REPORTING__ENABLED={{ authentik_environment_variables_authentik_error_reporting_enabled | to_json }}

{{ authentik_environment_variables_additional_variables }}
